<Window x:Class="RohreZuschnittOptimierung.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lizenz / PC-Code"
        Height="420" Width="560"
        MinHeight="360" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Lizenz / PC-Code"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="{DynamicResource SectionHeaderBrush}"/>
      <TextBlock x:Name="StatusTextBlock"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <TextBlock Text="PC-Code (an den Anbieter senden)"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PcCodeTextBox"
                 IsReadOnly="True"
                 Height="36"
                 Padding="10,6"
                 FontSize="16"
                 FontWeight="SemiBold"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Column="2"
                Content="Kopieren"
                Click="CopyPcCode_Click"
                Style="{DynamicResource AccentButtonStyle}"
                MinWidth="110"
                Height="36"/>
      </Grid>

      <TextBlock x:Name="UnlockHeadingTextBlock"
                 Text="Lizenzschlüssel vom Anbieter"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LicenseKeyTextBox"
                 Height="36"
                 Padding="10,6"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 ToolTip="Schlüssel, den Sie vom Anbieter erhalten"/>
        <Button Grid.Column="2"
                x:Name="ActivateButton"
                Content="Freischalten"
                Click="Activate_Click"
                Style="{DynamicResource SecondaryButtonStyle}"
                MinWidth="110"
                Height="36"/>
      </Grid>
    </StackPanel>

    <Button Grid.Row="2"
            Content="Schließen"
            Click="Close_Click"
            Style="{DynamicResource SecondaryButtonStyle}"
            HorizontalAlignment="Right"
            Width="120"
            Height="36"
            Margin="0,18,0,0"/>
  </Grid>
</Window>
