<Window x:Class="RohreZuschnittOptimierung.PdfSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Height="640"
        Width="580"
        MinHeight="520"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Einstellungen"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="{DynamicResource SectionHeaderBrush}"/>

    <TextBlock Grid.Row="1"
               Margin="0,10,0,16"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Text="Optimierung und PDF-Ausgabe. Originalstange und Schnittbreite gelten dauerhaft für alle Berechnungen."/>

    <Border Grid.Row="2"
            Padding="16"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource PanelBackgroundBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Optimierung"
                     Style="{DynamicResource SectionHeaderTextStyle}"
                     Margin="0,0,0,10"/>
          <TextBlock Text="Originalstange (mm)"
                     Margin="0,0,0,4"/>
          <TextBox x:Name="StockLengthMmTextBox"
                   Width="120"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,6"/>
          <TextBlock Text="Länge der Neuware (z. B. 6000 = 6,0 m). Wird nur bei Bedarf verwendet."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,12"/>
          <TextBlock Text="Schnittbreite (mm)"
                     Margin="0,0,0,4"/>
          <TextBox x:Name="KerfMmTextBox"
                   Width="120"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,6"/>
          <TextBlock Text="Materialverlust pro Schnitt (Sägeblatt). Standard: 3 mm."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,16"/>

          <TextBlock Text="PDF-Zuschnittplan"
                     Style="{DynamicResource SectionHeaderTextStyle}"
                     Margin="0,0,0,10"/>
          <TextBlock Text="Inhalte im Zuschnittplan-PDF"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,10"/>
          <CheckBox x:Name="ShowCreatedDateCheckBox"
                    Content="Erstellungsdatum"
                    Margin="0,0,0,8"/>
          <CheckBox x:Name="ShowSummaryHeaderCheckBox"
                    Content="Zusammenfassung (Stangen, Teile, Verschnitt)"
                    Margin="0,0,0,8"/>
          <CheckBox x:Name="ShowTotalSawSummaryCheckBox"
                    Content="Gesamt-Sägeverstellung"
                    Margin="0,0,0,16"/>

          <TextBlock Text="Inhalt"
                     Style="{DynamicResource SectionHeaderTextStyle}"
                     Margin="0,0,0,10"/>
          <CheckBox x:Name="ShowPartsOverviewCheckBox"
                    Content="Teileübersicht"
                    Margin="0,0,0,8"/>
          <CheckBox x:Name="ShowBarDiagramCheckBox"
                    Content="Stangendiagramm (Grafik)"
                    Margin="0,0,0,8"/>
          <CheckBox x:Name="ShowBarUsageInfoCheckBox"
                    Content="Stangen-Info (Genutzt, Rest, Säge verstellen)"
                    Margin="0,0,0,16"/>

          <TextBlock Text="Schnittfolge"
                     Style="{DynamicResource SectionHeaderTextStyle}"
                     Margin="0,0,0,10"/>
          <CheckBox x:Name="ShowDiagramCutSequenceLineCheckBox"
                    Content="Schnittfolge-Zeile unter dem Diagramm (z. B. 90° · 90° · 90°)"
                    Margin="0,0,0,8"/>
          <CheckBox x:Name="ShowDetailedCutSequenceCheckBox"
                    Content="Detaillierte Schnittfolge (nummerierte Schritte und Text)"
                    Margin="0,0,0,16"/>

          <TextBlock Text="Lokale Vision-KI (Länge &amp; Gehrung)"
                     Style="{DynamicResource SectionHeaderTextStyle}"
                     Margin="0,0,0,10"/>
          <TextBlock TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,10"
                     Text="Echte KI ist im Programmordner unter AI\ mitgeliefert. Keine separate Installation. Zeichnungen gehen nur an localhost auf diesem PC – nicht ins Internet."/>
          <CheckBox x:Name="LocalAiEnabledCheckBox"
                    Content="Vision-KI nutzen, wenn Länge/Gehrung in PDF/STEP fehlt"
                    IsChecked="True"
                    Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ProbeLocalAiButton"
                    Content="KI prüfen / starten"
                    Click="ProbeLocalAi_Click"
                    Padding="12,6"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
            <TextBlock x:Name="LocalAiStatusTextBlock"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Text="Einstellungen werden beim Speichern übernommen."/>
      <Button Grid.Column="1"
              Content="Speichern"
              Click="Save_Click"
              Padding="14,8"/>
      <Button Grid.Column="3"
              Style="{DynamicResource SecondaryButtonStyle}"
              Content="Schließen"
              Click="Close_Click"
              Padding="14,8"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
