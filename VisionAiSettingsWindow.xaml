<Window x:Class="RohreZuschnittOptimierung.VisionAiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision-KI"
        Height="380"
        Width="540"
        MinHeight="320"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Vision-KI"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="{DynamicResource SectionHeaderBrush}"/>

    <TextBlock Grid.Row="1"
               Margin="0,10,0,16"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Text="Lokale KI für Länge und Gehrung, wenn PDF/STEP keine Werte liefert."/>

    <Border Grid.Row="2"
            Padding="16"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource PanelBackgroundBrush}">
      <StackPanel>
        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,12"
                   Text="Echte KI ist im Programmordner unter AI\ mitgeliefert. Keine separate Installation. Zeichnungen gehen nur an localhost auf diesem PC – nicht ins Internet."/>
        <CheckBox x:Name="LocalAiEnabledCheckBox"
                  Content="Vision-KI nutzen, wenn Länge/Gehrung in PDF/STEP fehlt"
                  IsChecked="True"
                  Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ProbeLocalAiButton"
                  Content="KI prüfen / starten"
                  Click="ProbeLocalAi_Click"
                  Padding="12,6"
                  Style="{DynamicResource SecondaryButtonStyle}"/>
          <TextBlock x:Name="LocalAiStatusTextBlock"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Text="Änderungen werden beim Speichern übernommen."/>
      <Button Grid.Column="1"
              Content="Speichern"
              Click="Save_Click"
              Padding="14,8"/>
      <Button Grid.Column="3"
              Style="{DynamicResource SecondaryButtonStyle}"
              Content="Schließen"
              Click="Close_Click"
              Padding="14,8"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
