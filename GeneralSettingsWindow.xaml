<Window x:Class="RohreZuschnittOptimierung.GeneralSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimierung"
        Height="360"
        Width="520"
        MinHeight="300"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Optimierung"
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="{DynamicResource SectionHeaderBrush}"/>

    <TextBlock Grid.Row="1"
               Margin="0,10,0,16"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Text="Originalstange und Schnittbreite gelten dauerhaft für alle Berechnungen."/>

    <Border Grid.Row="2"
            Padding="16"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource PanelBackgroundBrush}">
      <StackPanel>
        <TextBlock Text="Originalstange (mm)"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="StockLengthMmTextBox"
                 Width="120"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,6"/>
        <TextBlock Text="Länge der Neuware (z. B. 6000 = 6,0 m). Wird nur bei Bedarf verwendet."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,16"/>
        <TextBlock Text="Schnittbreite (mm)"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="KerfMmTextBox"
                 Width="120"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,6"/>
        <TextBlock Text="Materialverlust pro Schnitt (Sägeblatt). Standard: 3 mm."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMutedBrush}"
                 Text="Änderungen werden beim Speichern übernommen."/>
      <Button Grid.Column="1"
              Content="Speichern"
              Click="Save_Click"
              Padding="14,8"/>
      <Button Grid.Column="3"
              Style="{DynamicResource SecondaryButtonStyle}"
              Content="Schließen"
              Click="Close_Click"
              Padding="14,8"
              IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
