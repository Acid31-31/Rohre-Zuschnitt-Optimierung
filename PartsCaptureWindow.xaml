<Window x:Class="RohreZuschnittOptimierung.PartsCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teile erfassen"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="True">
      <Button DockPanel.Dock="Right"
              Content="Fertig"
              Style="{DynamicResource AccentButtonStyle}"
              Click="Done_Click"
              Padding="22,10"
              FontSize="15"
              FontWeight="SemiBold"
              MinWidth="140"
              ToolTip="Zurück zur Übersicht (Esc)"/>
      <StackPanel>
        <TextBlock Text="Teile erfassen"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <TextBlock Text="Rohrlänge, Gehrung und Stückzahl eintragen – Profil gilt für die gesamte Optimierung."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Eingabe -->
      <Border Grid.Column="0"
              Padding="24"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Background="{DynamicResource PanelBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Rohrprofil"
                       Style="{DynamicResource SectionHeaderTextStyle}"
                       Margin="0,0,0,12"/>
            <Button x:Name="SelectProfileButton"
                    Content="Profil wählen …"
                    Click="SelectProfile_Click"
                    HorizontalAlignment="Stretch"
                    Padding="14,12"
                    FontSize="15"
                    Margin="0,0,0,8"
                    ToolTip="Profil und Materialart für diese Optimierung"/>
            <TextBlock x:Name="ProfileDisplayTextBlock"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"
                       Text="Noch kein Profil gewählt"/>

            <TextBlock Text="Maße"
                       Style="{DynamicResource SectionHeaderTextStyle}"
                       Margin="0,0,0,14"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="Rohrlänge (mm)"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,6"/>
              <TextBox Grid.Row="1" Grid.Column="0"
                       x:Name="PartLengthTextBox"
                       FontSize="22"
                       Padding="12,14"
                       Margin="0,0,0,18"
                       ToolTip="Zuschnittlänge in Millimetern"/>

              <TextBlock Grid.Row="0" Grid.Column="2"
                         Text="Stückzahl"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,6"/>
              <TextBox Grid.Row="1" Grid.Column="2"
                       x:Name="PartQuantityTextBox"
                       Text="1"
                       FontSize="22"
                       Padding="12,14"
                       Margin="0,0,0,18"/>

              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="Gehrung Ende A (°)"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,6"/>
              <TextBox Grid.Row="3" Grid.Column="0"
                       x:Name="MiterEnd1TextBox"
                       Text="0"
                       FontSize="22"
                       Padding="12,14"/>

              <TextBlock Grid.Row="2" Grid.Column="2"
                         Text="Gehrung Ende B (°)"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,6"/>
              <TextBox Grid.Row="3" Grid.Column="2"
                       x:Name="MiterEnd2TextBox"
                       Text="0"
                       FontSize="22"
                       Padding="12,14"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Text="0° oder 90° = lotrecht. Gehrung z. B. 45. Beide Enden möglich (45/45)."
                         TextWrapping="Wrap"
                         Margin="0,14,0,0"/>
            </Grid>

            <Button x:Name="AddPartButton"
                    Content="Zur Teilliste hinzufügen"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="AddPart_Click"
                    Padding="18,14"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch"
                    Margin="0,28,0,0"
                    ToolTip="Teil übernehmen (Enter)"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Teilliste -->
      <Border Grid.Column="2"
              Padding="20"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Background="{DynamicResource PanelBackgroundBrush}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Teilliste"
                       Style="{DynamicResource SectionHeaderTextStyle}"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="PartsCountTextBlock"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Noch keine Teile"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Aus Liste bearbeiten"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="EditSelected_Click"
                    Padding="14,8"
                    Margin="0,0,10,0"/>
            <Button Content="Auswahl entfernen"
                    Style="{DynamicResource DangerButtonStyle}"
                    Click="RemoveSelected_Click"
                    Padding="14,8"/>
          </StackPanel>

          <DataGrid x:Name="PartsGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    MouseDoubleClick="PartsGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Zeichnung"
                                  Binding="{Binding DrawingName}"
                                  Width="*"/>
              <DataGridTextColumn Header="Länge (mm)"
                                  Binding="{Binding LengthMm}"
                                  Width="100"/>
              <DataGridTextColumn Header="Gehr. A"
                                  Binding="{Binding MiterEnd1Deg}"
                                  Width="70"/>
              <DataGridTextColumn Header="Gehr. B"
                                  Binding="{Binding MiterEnd2Deg}"
                                  Width="70"/>
              <DataGridTextColumn Header="Stück"
                                  Binding="{Binding Quantity}"
                                  Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="4"
               Foreground="{DynamicResource TextMutedBrush}"
               Text="Esc = schließen · Enter = hinzufügen / übernehmen"/>
  </Grid>
</Window>
