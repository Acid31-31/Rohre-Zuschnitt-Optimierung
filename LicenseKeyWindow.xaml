<Window x:Class="RohreZuschnittOptimierung.LicenseKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KEY_Rohre_Zuschitt"
        Height="620" Width="680"
        MinHeight="540" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="TitleTextBlock"
                 Text="KEY_Rohre_Zuschitt"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="{DynamicResource SectionHeaderBrush}"/>
      <TextBlock Text="Ein PC-Code = Schlüssel für alle App-Versionen. Beide Varianten werden erzeugt; der Kunde kann alles auf einmal einfügen."
                 TextWrapping="Wrap"
                 Margin="0,8,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <TextBlock Text="Dieser PC" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="PC-Code" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
      <Grid Margin="0,4,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ThisPcCodeTextBox" IsReadOnly="True" Height="34" Padding="10,6" VerticalContentAlignment="Center"/>
        <Button Grid.Column="2" Content="Kopieren" Click="CopyThisPcCode_Click"
                Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" Height="34"/>
      </Grid>
      <TextBlock Text="Schlüssel für diesen PC" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
      <Grid Margin="0,4,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ThisPcKeyTextBox" IsReadOnly="True" Height="34" Padding="10,6" VerticalContentAlignment="Center"/>
        <Button Grid.Column="2" Content="Kopieren" Click="CopyThisPcKey_Click"
                Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" Height="34"/>
      </Grid>

      <TextBlock Text="Schlüssel für Kunden-PC" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="PC-Code(s) vom Kunden – eine Zeile je PC" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
      <Grid Margin="0,4,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="CustomerCodeTextBox"
                 Height="72"
                 Padding="10,6"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 ToolTip="PC-Code aus Lizenz oder Ablauf-Fenster. Mehrere PCs: eine Zeile je Code."/>
        <Button Grid.Column="2" Content="Erzeugen" Click="GenerateCustomerKey_Click"
                Style="{DynamicResource AccentButtonStyle}" MinWidth="100" Height="34"
                VerticalAlignment="Top"/>
      </Grid>
      <TextBlock Text="Lizenzschlüssel (an den Kunden senden, nur den passenden PC)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="CustomerKeyTextBox"
                 IsReadOnly="True"
                 Height="88"
                 Padding="10,6"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"/>
        <Button Grid.Column="2" Content="Kopieren" Click="CopyCustomerKey_Click"
                Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" Height="34"
                VerticalAlignment="Top"/>
      </Grid>
    </StackPanel>

    <Button Grid.Row="2"
            Content="Schließen"
            Click="Close_Click"
            Style="{DynamicResource SecondaryButtonStyle}"
            HorizontalAlignment="Right"
            Width="120"
            Height="36"
            Margin="0,18,0,0"/>
  </Grid>
</Window>
