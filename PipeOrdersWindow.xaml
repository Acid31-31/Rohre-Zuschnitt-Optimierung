<Window x:Class="RohreZuschnittOptimierung.PipeOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufträge"
        Height="700"
        Width="980"
        MinHeight="500"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Aufträge"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource SectionHeaderBrush}"/>
      <TextBlock Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Schnittpläne nach Auftragsnummer. Bei bestelltem Material: Wareneingang buchen, nach dem Schneiden „Schnitt verbuchen“ — dann werden Verbrauch und Rohreste ins Lager geschrieben."/>
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,16,0,10">
      <Button x:Name="ReceiveMaterialButton"
              Content="Material eingetroffen"
              Style="{DynamicResource SuccessButtonStyle}"
              Click="ReceiveMaterial_Click"
              Padding="12,6"
              Margin="0,0,8,8"
              IsEnabled="False"
              ToolTip="Bestellmenge ins Lager buchen"/>
      <Button x:Name="CompleteCutButton"
              Content="Schnitt verbuchen"
              Style="{DynamicResource AccentButtonStyle}"
              Click="CompleteCut_Click"
              Padding="12,6"
              Margin="0,0,8,8"
              IsEnabled="False"
              ToolTip="Verbrauch reservieren und Rohreste ins Lager zurückbuchen"/>
      <Button Content="Aktualisieren"
              Style="{DynamicResource SecondaryButtonStyle}"
              Click="Reload_Click"
              Padding="12,6"
              Margin="0,0,8,8"/>
    </WrapPanel>

    <DataGrid x:Name="OrdersGrid"
              Grid.Row="2"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              SelectionChanged="OrdersGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Auftragsnummer"
                            Binding="{Binding OrderReference}"
                            Width="160"/>
        <DataGridTextColumn Header="Status"
                            Binding="{Binding StatusLabel}"
                            Width="220"/>
        <DataGridTextColumn Header="Profil"
                            Binding="{Binding ProfileLabel}"
                            Width="*"/>
        <DataGridTextColumn Header="Material"
                            Binding="{Binding Material}"
                            Width="110"/>
        <DataGridTextColumn Header="Bestellt"
                            Binding="{Binding OrderedNewBarsCount}"
                            Width="70"/>
        <DataGridTextColumn Header="Aktualisiert"
                            Binding="{Binding UpdatedLocal}"
                            Width="130"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock x:Name="DetailTextBlock"
               Grid.Row="3"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}"
               Text="Auftrag auswählen."/>
  </Grid>
</Window>
