<Window x:Class="RohreZuschnittOptimierung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:RohreZuschnittOptimierung.Controls"
        mc:Ignorable="d"
        Title="Rohre Zuschnitt Optimierung"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="980"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
      <Button x:Name="ThemeToggleHeaderButton"
              DockPanel.Dock="Right"
              Margin="8,4,12,4"
              Padding="12,6"
              Style="{StaticResource SecondaryButtonStyle}"
              Click="ThemeToggleButton_Click"
              ToolTip="Zwischen Dunkel- und Hellmodus wechseln"/>
      <Menu>
      <MenuItem Header="Datei">
        <MenuItem x:Name="ExportPdfMenuItem"
                  Header="Zuschnittplan speichern unter …"
                  Click="ExportPdf_Click"
                  IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="Beenden"
                  Click="ExitApplication_Click"/>
      </MenuItem>
      <MenuItem Header="Lager">
        <MenuItem Header="Lagerverwaltung …"
                  Click="OpenWarehouse_Click"/>
        <MenuItem Header="Aufträge …"
                  Click="OpenOrders_Click"/>
      </MenuItem>
      <MenuItem Header="Einstellungen">
        <MenuItem Header="Einstellungen …"
                  Click="OpenPdfSettings_Click"/>
        <Separator/>
        <MenuItem x:Name="ThemeToggleMenuItem"
                  Header="Hellmodus"
                  Click="ThemeToggleButton_Click"/>
      </MenuItem>
      <MenuItem Header="Info">
        <MenuItem Header="Nach Updates suchen …"
                  Click="CheckForUpdates_Click"/>
        <MenuItem Header="Über die Anwendung …"
                  Click="ShowAbout_Click"/>
      </MenuItem>
    </Menu>
    </DockPanel>

    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="430"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Planung in 3 Schritten"
                     Style="{DynamicResource SectionHeaderTextStyle}"
                     Margin="0,0,0,16"/>

          <!-- Schritt 1 -->
          <TextBlock Text="1. Auftrag &amp; Profil"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>

          <TextBlock Text="Auftragsnummer *"
                     FontWeight="SemiBold"
                     Margin="0,0,0,4"/>
          <TextBox x:Name="OrderReferenceTextBox"
                   MaxLength="80"
                   Margin="0,0,0,4"
                   ToolTip="Pflichtfeld. Wird in PDFs und Lagerreservierung verwendet."/>
          <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,12"
                     Text="* Pflichtfeld vor dem Optimieren"/>

          <TextBlock Text="Rohrprofil zum Schneiden" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <Button x:Name="SelectCutProfileButton"
                  Content="Profil wählen …"
                  Click="SelectCutProfile_Click"
                  HorizontalAlignment="Stretch"
                  Padding="12,8"
                  Margin="0,0,0,4"
                  ToolTip="Profil und Materialart (Stahl, Edelstahl, Aluminium) für diese Optimierung"/>
          <TextBlock x:Name="CutProfileDisplayTextBlock"
                     Foreground="{DynamicResource AccentBrush}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,4"
                     TextWrapping="Wrap"
                     Text="Noch kein Profil gewählt"/>
          <TextBlock x:Name="WarehouseStatusTextBlock"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,0,0,12"
                     TextWrapping="Wrap"
                     Text="Profil und Materialart wählen — nur passender Lagerbestand wird verwendet."/>

          <TextBlock Text="Material aus Lager" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                     TextWrapping="Wrap"
                     Text="Wird aus dem Lager geladen (Menü Lager → Lagerverwaltung)."/>
          <DataGrid x:Name="RemnantsGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    HeadersVisibility="Column"
                    Height="100"
                    Margin="0,0,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Länge (mm)"
                                  Binding="{Binding LengthMm, UpdateSourceTrigger=PropertyChanged}"
                                  Width="*"/>
              <DataGridTextColumn Header="Stück"
                                  Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                  Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"
                     TextWrapping="Wrap"
                     Text="Rohreste werden zuerst verbraucht, danach neue Stangen."/>

          <!-- Schritt 2 -->
          <TextBlock Text="2. Teile erfassen"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>

          <TextBlock Text="Länge und Stückzahl eingeben"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Rohrlänge (mm)" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="PartLengthTextBox" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Stückzahl" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="PartQuantityTextBox" Text="1" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gehrung Ende A (°)" Margin="0,0,0,4"/>
            <TextBox Grid.Row="3" Grid.Column="0" x:Name="MiterEnd1TextBox" Text="0"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Gehrung Ende B (°)" Margin="0,0,0,4"/>
            <TextBox Grid.Row="3" Grid.Column="2" x:Name="MiterEnd2TextBox" Text="0"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="0° oder 90° = lotrecht. Gehrung z.B. 45. Beide Enden möglich (45/45)."
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
          </Grid>

          <Button x:Name="AddPartButton"
                  Content="Zur Teilliste hinzufügen"
                  Click="AddPartFromPdf_Click"
                  Padding="14,8"
                  FontWeight="SemiBold"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,12"
                  ToolTip="Teil jetzt in die Liste übernehmen"/>

          <Expander x:Name="PdfImportExpander"
                    Header="Optional: aus PDF übernehmen"
                    IsExpanded="False"
                    Margin="0,0,0,16">
            <StackPanel Margin="0,10,0,0">
              <Border x:Name="PdfDropBorder"
                      AllowDrop="True"
                      BorderBrush="{DynamicResource PanelBorderBrush}"
                      BorderThickness="2"
                      CornerRadius="8"
                      Background="{DynamicResource CardBackgroundBrush}"
                      Padding="16"
                      Margin="0,0,0,10"
                      Cursor="Hand"
                      DragEnter="PdfDropBorder_DragEnter"
                      DragOver="PdfDropBorder_DragOver"
                      DragLeave="PdfDropBorder_DragLeave"
                      Drop="PdfDropBorder_Drop"
                      MouseLeftButtonUp="PdfDropBorder_Click"
                      ToolTip="PDF/ZIP und optional Excel (.xlsx) hierher ziehen oder anklicken">
                <StackPanel>
                  <TextBlock Text="PDF, ZIP oder Excel hierher ziehen"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,6"/>
                  <TextBlock x:Name="PdfFolderTextBlock"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Text="ZIP mit Zeichnungen ablegen; Excel (.xlsx) optional zusätzlich – Länge und Bestellmenge werden übernommen."/>
                </StackPanel>
              </Border>

              <TextBlock Text="Erkannte Zeichnungen" Margin="0,0,0,4"/>
              <ComboBox x:Name="PdfComboBox"
                        DisplayMemberPath="FileName"
                        SelectionChanged="PdfComboBox_SelectionChanged"
                        Margin="0,0,0,8"/>

              <TextBlock x:Name="AnalysisTextBlock"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="PDF oder ZIP ablegen – Länge und Gehrung werden erkannt und in die Teilliste übernommen."/>
            </StackPanel>
          </Expander>

          <!-- Schritt 3 -->
          <TextBlock Text="3. Optimieren"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>

          <TextBlock Text="Teilliste" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Bearbeiten"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="EditSelectedPart_Click"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    ToolTip="Ausgewählte Zeile oben in die Eingabe laden"/>
            <Button Content="Alles löschen"
                    Style="{DynamicResource DangerButtonStyle}"
                    Click="ClearAll_Click"
                    Padding="12,6"
                    ToolTip="Teilliste, Eingabe und Schnittplan zurücksetzen"/>
          </StackPanel>
          <DataGrid x:Name="PartsGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    HeadersVisibility="Column"
                    Height="200"
                    Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Zeichnung"
                                  Binding="{Binding DrawingName, UpdateSourceTrigger=PropertyChanged}"
                                  Width="120"/>
              <DataGridTextColumn Header="Länge (mm)"
                                  Binding="{Binding LengthMm, UpdateSourceTrigger=PropertyChanged}"
                                  Width="90"/>
              <DataGridTextColumn Header="Gehr. A"
                                  Binding="{Binding MiterEnd1Deg, UpdateSourceTrigger=PropertyChanged}"
                                  Width="60"/>
              <DataGridTextColumn Header="Gehr. B"
                                  Binding="{Binding MiterEnd2Deg, UpdateSourceTrigger=PropertyChanged}"
                                  Width="60"/>
              <DataGridTextColumn Header="Stück"
                                  Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                  Width="50"/>
            </DataGrid.Columns>
          </DataGrid>

          <Button x:Name="OptimizeButton"
                  Content="Optimieren"
                  Click="Optimize_Click"
                  Padding="18,10"
                  FontSize="14"
                  FontWeight="SemiBold"
                  HorizontalAlignment="Stretch"
                  ToolTip="Benötigt Auftragsnummer, Profil und mindestens ein Teil"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2"
              Padding="16"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{DynamicResource PanelBackgroundBrush}">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Schnittplan"
                       Style="{DynamicResource SectionHeaderTextStyle}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    x:Name="ExportPdfButton"
                    Content="Zuschnittplan speichern unter …"
                    Click="ExportPdf_Click"
                    Padding="14,6"
                    IsEnabled="False"
                    ToolTip="Nach dem Optimieren öffnet sich die PDF automatisch. Hier speichern Sie eine Kopie an einem anderen Ort."/>
          </Grid>

          <TextBlock x:Name="SummaryTextBlock"
                     DockPanel.Dock="Top"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,12"
                     Text="Noch keine Berechnung. Nach Schritt 3 erscheint hier der Schnittplan."/>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PlanItemsControl">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,14"
                          Padding="12"
                          BorderBrush="{DynamicResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Header}"/>
                      <controls:PipeCutBarDiagram Margin="0,10,0,8"
                                                  Height="168"
                                                  BarPlan="{Binding Bar}"
                                                  StockLengthMm="{Binding StockLengthMm}"
                                                  KerfMm="{Binding KerfMm}"/>
                      <TextBlock TextWrapping="Wrap"
                                 Foreground="{DynamicResource CardTextSecondaryBrush}"
                                 Text="{Binding Details}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="1"
               Foreground="{DynamicResource TextFooterBrush}"
               Text="1 Auftrag &amp; Profil · 2 Teile · 3 Optimieren"/>
    </Grid>
  </DockPanel>
</Window>
