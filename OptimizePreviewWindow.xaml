<Window x:Class="RohreZuschnittOptimierung.OptimizePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt prüfen – PDF-Vorschau"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Rohre prüfen – PDF-Vorschau"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,8"/>

    <TextBlock x:Name="SummaryTextBlock"
               Grid.Row="1"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}"
               Margin="0,0,0,12"/>

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="PartsGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                HeadersVisibility="Column"
                SelectionChanged="PartsGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Zeichnung" Binding="{Binding DrawingName}" Width="*"/>
          <DataGridTextColumn Header="Länge" Binding="{Binding LengthText}" Width="80"/>
          <DataGridTextColumn Header="Stk" Binding="{Binding Quantity}" Width="40"/>
          <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
        </DataGrid.Columns>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTooLong}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding LengthMissing}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>

      <Border Grid.Column="2"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{DynamicResource PanelBackgroundBrush}"
              Padding="8">
        <DockPanel LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="PDF öffnen"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="12,6"
                    Click="OpenPdf_Click"/>
            <TextBlock x:Name="PreviewTitleTextBlock"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="PDF-Vorschau"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock x:Name="PreviewStatusTextBlock"
                     DockPanel.Dock="Bottom"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Text="Zeichnung in der Liste auswählen."/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- Weißer Grund: PDF-Seiten haben oft Transparenz; dunkles UI würde sie „schwarz“ zeigen. -->
            <Border Background="White" Padding="4">
              <Image x:Name="PreviewImage"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="WarningTextBlock"
               Grid.Row="3"
               TextWrapping="Wrap"
               Foreground="{DynamicResource DangerButtonBackgroundBrush}"
               Margin="0,0,0,12"
               Visibility="Collapsed"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ContinueButton"
              Content="Optimierung starten"
              Style="{DynamicResource AccentButtonStyle}"
              Width="170"
              Height="36"
              Margin="0,0,8,0"
              Click="Continue_Click"/>
      <Button Content="Zurück und korrigieren"
              Style="{DynamicResource SecondaryButtonStyle}"
              Width="180"
              Height="36"
              IsCancel="True"
              Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
