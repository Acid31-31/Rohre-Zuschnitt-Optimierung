<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RohreZuschnittOptimierung</AssemblyName>
    <RootNamespace>RohreZuschnittOptimierung</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>Rohre Zuschnitt Optimierung</AssemblyTitle>
    <Product>Rohre Zuschnitt Optimierung</Product>
    <Version>1.0.43</Version>
    <AssemblyVersion>1.0.0.43</AssemblyVersion>
    <FileVersion>1.0.0.43</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DrawingPreviewTool" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="PDFsharp" Version="6.2.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppLogo.png" />
    <None Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" Link="AppIcon.ico" />
    <None Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" Link="AppIcon.png" />
    <None Include="Assets\DrawingLogo.png" CopyToOutputDirectory="PreserveNewest" Link="DrawingLogo.png" Condition="Exists('Assets\DrawingLogo.png')" />
    <EmbeddedResource Include="Assets\DrawingLogo.png" LogicalName="DrawingLogo.png" Condition="Exists('Assets\DrawingLogo.png')" />
    <None Include="LICENSE_DE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="KEY_Rohre_Zuschitt.allow" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CodeSigning.cer" CopyToOutputDirectory="PreserveNewest" Condition="Exists('CodeSigning.cer')" />
    <None Include="native\pdfium.dll" CopyToOutputDirectory="PreserveNewest" Link="pdfium.dll" Condition="Exists('native\pdfium.dll')" />
  </ItemGroup>

  <Target Name="CopyVendorLicenseKeyTool" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)KEY_Rohre_Zuschitt.exe" SkipUnchangedFiles="true" />
  </Target>

</Project>
