<Window x:Class="RohreZuschnittOptimierung.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update verfügbar"
        Height="520" Width="580"
        MinHeight="420" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Eine neuere Version ist auf GitHub verfügbar."
                 FontSize="16"
                 FontWeight="SemiBold"/>
      <TextBlock x:Name="SizeTextBlock"
                 Margin="0,10,0,0"
                 FontSize="22"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>

    <Border Grid.Row="1"
            x:Name="NotesBorder"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Background="{DynamicResource CardBackgroundBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="VersionTextBlock" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="Änderungen in diesem Update:"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
          <ItemsControl x:Name="ChangesItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NotesTextBlock"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="Collapsed"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel x:Name="ProgressPanel"
                Grid.Row="2"
                Margin="0,12,0,8"
                Visibility="Collapsed">
      <TextBlock x:Name="DownloadSizeTextBlock"
                 FontSize="20"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <ProgressBar x:Name="UpdateProgressBar"
                   Height="10"
                   Minimum="0"
                   Maximum="100"
                   Value="0"
                   Foreground="{DynamicResource AccentBrush}"
                   Background="{DynamicResource PanelBorderBrush}"/>
      <Grid Margin="0,8,0,0">
        <TextBlock x:Name="StatusTextBlock"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="PercentTextBlock"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   VerticalAlignment="Center"
                   Text="0 %"/>
      </Grid>
      <TextBlock x:Name="RemainingTimeTextBlock"
                 Margin="0,6,0,0"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AccentBrush}"
                 Text="Restlaufzeit wird berechnet…"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="UpdateButton"
              Content="Jetzt aktualisieren"
              Style="{DynamicResource AccentButtonStyle}"
              Width="160"
              Height="36"
              Margin="0,0,8,0"
              Click="UpdateButton_Click"/>
      <Button x:Name="LaterButton"
              Content="Später"
              Style="{DynamicResource SecondaryButtonStyle}"
              Width="100"
              Height="36"
              Click="LaterButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
