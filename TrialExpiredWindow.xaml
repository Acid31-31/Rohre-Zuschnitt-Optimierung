<Window x:Class="RohreZuschnittOptimierung.TrialExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Testversion abgelaufen"
        Height="360" Width="540"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Testversion abgelaufen"
               FontSize="20"
               FontWeight="Bold"
               Foreground="{DynamicResource DangerButtonBackgroundBrush}"
               Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1">
      <TextBlock x:Name="MessageTextBlock"
                 TextWrapping="Wrap"
                 FontSize="14"
                 LineHeight="22"/>
      <TextBlock x:Name="DetailTextBlock"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="0,12,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button x:Name="UpdateButton"
              Content="Update prüfen"
              Style="{DynamicResource SecondaryButtonStyle}"
              Click="Update_Click"
              Width="140"
              Height="36"
              Margin="0,0,10,0"/>
      <Button Content="Schließen"
              Style="{DynamicResource AccentButtonStyle}"
              Click="Close_Click"
              Width="120"
              Height="36"/>
    </StackPanel>
  </Grid>
</Window>
