<Window x:Class="RohreZuschnittOptimierung.TrialExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Testversion abgelaufen"
        Height="540" Width="580"
        MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Testversion abgelaufen"
               FontSize="20"
               FontWeight="Bold"
               Foreground="{DynamicResource DangerButtonBackgroundBrush}"
               Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1">
      <TextBlock x:Name="MessageTextBlock"
                 TextWrapping="Wrap"
                 FontSize="14"
                 LineHeight="22"/>
      <TextBlock x:Name="DetailTextBlock"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Margin="0,10,0,0"/>

      <TextBlock Text="PC-Code (an den Anbieter senden)"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Margin="0,16,0,6"/>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PcCodeTextBox"
                 IsReadOnly="True"
                 Height="36"
                 Padding="10,6"
                 FontSize="16"
                 FontWeight="SemiBold"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Column="2"
                Content="Kopieren"
                Click="CopyPcCode_Click"
                Style="{DynamicResource AccentButtonStyle}"
                MinWidth="110"
                Height="36"/>
      </Grid>
      <TextBlock Text="Lizenzschlüssel vom Anbieter"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LicenseKeyTextBox"
                 Height="34"
                 Padding="10,6"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 ToolTip="Lizenzschlüssel vom Anbieter"/>
        <Button Grid.Column="2"
                Content="Freischalten"
                Click="Activate_Click"
                Style="{DynamicResource AccentButtonStyle}"
                MinWidth="120"
                Height="34"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="UpdateButton"
              Content="Update prüfen"
              Style="{DynamicResource SecondaryButtonStyle}"
              Click="Update_Click"
              Width="140"
              Height="36"
              Margin="0,0,10,0"/>
      <Button Content="Schließen"
              Style="{DynamicResource SecondaryButtonStyle}"
              Click="Close_Click"
              Width="120"
              Height="36"/>
    </StackPanel>
  </Grid>
</Window>
